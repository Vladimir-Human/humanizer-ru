{
  "schema_version": "contract.v1",
  "id": "humanizer-ru-contract",
  "language": "ru",
  "product": {
    "name": "humanizer-ru",
    "version": "3.33.0",
    "install": {
      "pip": "pip install humanizer-ru==3.33.0",
      "requires_python": ">=3.9",
      "freshness": "сверьте версию с https://github.com/Vladimir-Human/humanizer-ru/releases/latest или лентой releases.atom"
    },
    "identity": "нормализатор и диагност русского текста; переписывание — только по явной просьбе и без заявлений о качестве",
    "scope": "русский связный текст",
    "not_for": [
      "текст не на русском",
      "исходный код и конфиги",
      "юридические документы",
      "художественная проза и поэзия"
    ]
  },
  "prohibited_uses": {
    "status": "withdrawn",
    "since": "3.32.1",
    "note": "Политика ограниченных сценариев снята 2026-09-05; блок сохранён пустым исключительно для совместимости чтения contract.v1 и не восстанавливает политику.",
    "list": []
  },
  "output_envelope": {
    "format": "json",
    "fields": {
      "tool": "имя инструмента (строка)",
      "schema": "версия схемы вывода инструмента (целое)",
      "files": "список отчётов по файлам",
      "error": "только при ошибке входа (код 2): человекочитаемая причина"
    },
    "rule": "версия схемы растёт только при несовместимом изменении вывода",
    "error_rule": "с --json код 2 печатает конверт {tool, schema, error, files} в stdout — агент всегда получает разобранный JSON, а не голый stderr"
  },
  "exit_codes": {
    "0": "успех: инструмент отработал, нарушений инвариантов нет",
    "1": "найдены артефакты или нарушение инварианта (для CI-гейтов вызывающего)",
    "2": "вход не читается (нет файла, не UTF-8); с --json конверт ошибки в stdout",
    "note": "код 3 зарезервирован за «вне области» и не используется: вместо отказа всегда градуированный ответ, а пустой и не-русский вход помечаются out-of-scope"
  },
  "graduated_response": {
    "rule": "на любом входе ответ не пустой: минимум типографика и список артефактов копипасты; детектор связок добавляет статус домена",
    "out_of_scope": "пустой вход и текст не на русском: механика отрабатывает, но ответ несёт status out-of-scope и scope_note — область скилла русский текст, «правка не требуется» таким входам не адресуется",
    "empty_response_is": "дефект дизайна, а не честность"
  },
  "genres": {
    "dictionary": [
      "neutral",
      "fiction",
      "legal",
      "academic",
      "marketing",
      "chat",
      "instructions",
      "essay",
      "prose",
      "web",
      "auto"
    ],
    "effective_by_tool": {
      "humanizer-scan": [
        "neutral",
        "fiction",
        "legal",
        "academic",
        "marketing",
        "chat"
      ],
      "humanizer-detect": [
        "instructions",
        "essay",
        "prose",
        "web",
        "auto"
      ]
    },
    "rule": "единый словарь --genre для всех CLI: счётчик признаков отображает чужие домены в neutral, детектор связок для чужих значений включает автоклассификацию (auto); эффективные домены: счётчик — neutral/fiction/legal/academic/marketing/chat, детектор — instructions/essay/prose/web/auto"
  },
  "tools": [
    {
      "command": "humanizer-polish",
      "script": "scripts/polish.py",
      "task": "типографическая нормализация: тире, кавычки, многоточие, невидимые символы, маркеры разметки, переносы строк к LF",
      "transformation": "дефолтный режим снимает машинный слой типографики: невидимые символы и NBSP, **/__, хэши заголовков, выравнивает тире/ёлочки/многоточия в плоский текст, переносы строк к LF; --preserve-markup снимает только невидимые символы и NBSP в прозе, сохраняя разметку и типографику; --typographic — публикационный режим: парные прямые кавычки в ёлочки, три точки в единый символ многоточия, невидимые символы снимаются только в прозе; оба безопасных режима опираются на единый источник защищённых областей: fenced-блоки, YAML-frontmatter, инлайн-код (серии бэктиков фиксированной длины), URL, HTML-теги с кавычками атрибутов и ZWJ-кластеры составных эмодзи не трогаются, при недоступности правил защиты режим отказывает вместо небезопасного преобразования; постановку тире по русской норме делает агентный слой по SKILL.md",
      "when_not": "не запускать на Markdown и разметке дефолтным режимом: снимает ##, **, ёлочки, тире, многоточие — для разметки режимы --preserve-markup и --typographic; когда нужна правка лексики или смысла — полировка слов не трогает",
      "invariants": [
        "идемпотентность",
        "буквы и цифры дословно",
        "сохранение защищённых областей в режимах --preserve-markup и --typographic: URL, кавычки атрибутов, ZWJ-кластеры и содержимое кода остаются байт-в-байт, нарушения попадают в список invariants и дают код 1"
      ],
      "modes": [
        "stdout",
        "--diff",
        "--in-place (.bak)",
        "--dry-run",
        "--json",
        "--preserve-markup",
        "--typographic",
        "--gate ПУТЬ",
        "--selftest",
        "- (stdin)",
        "--version",
        "--contract"
      ],
      "output_schema": {
        "type": "object",
        "required": [
          "tool",
          "schema",
          "files"
        ],
        "properties": {
          "tool": {
            "const": "humanizer-polish"
          },
          "schema": {
            "const": 1
          },
          "error": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "changed": {
                  "type": "boolean"
                },
                "chars_before": {
                  "type": "integer"
                },
                "chars_after": {
                  "type": "integer"
                },
                "preserve_markup": {
                  "type": "boolean"
                },
                "typographic": {
                  "type": "boolean"
                },
                "invariants": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "status": {
                  "enum": [
                    "out-of-scope"
                  ]
                },
                "scope_note": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "command": "humanizer-detect",
      "script": "scripts/detect_conj.py",
      "task": "частота связок: признак машинного текста в домене «чистая проза, инструкции»",
      "when_not": "эссе и художественная проза — не валидировано; веб-текст с артефактами — неприменимо; вердикт об авторстве не выносится никогда",
      "domains": {
        "instructions": "works",
        "essay": "not-validated",
        "prose": "not-validated",
        "web": "not-applicable"
      },
      "modes": [
        "stdout",
        "--json",
        "--genre",
        "--gate ПУТЬ",
        "--selftest",
        "- (stdin)",
        "--version",
        "--contract"
      ],
      "output_schema": {
        "type": "object",
        "required": [
          "tool",
          "schema",
          "files"
        ],
        "properties": {
          "tool": {
            "const": "humanizer-detect"
          },
          "schema": {
            "const": 1
          },
          "error": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "conj_density": {
                  "type": "number"
                },
                "words_total": {
                  "type": "integer"
                },
                "genre": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "direction": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "scope_note": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "command": "humanizer-markers",
      "script": "scripts/check_markers.py",
      "task": "артефакты копипасты и чат-интерфейсов: 40 маркеров классов A и B; находит и показывает; --remove снимает невидимые метки текстового слоя по классификации риска (safe автоматически, ambiguous только opt-in, dangerous никогда)",
      "when_not": "не детектор генерации: отсутствие маркеров не доказывает авторство человека; контейнерные файлы (PNG/DOCX/PDF/…) — scripts/filemarks (репозиторий); текстовый слой снятия входит в пакет (text_layer)",
      "removal_guards": [
        "снятие текстового пути не трогает защищённые области: fenced-блоки, YAML-frontmatter и инлайн-код сохраняются байт-в-байт (единый источник правил — scripts/protected_regions.py)",
        "не-URL маркеры не снимаются внутри URL-спанов: снятие совпадает с границей детектора (маскирование URL)",
        "снятие utm/referrer-параметров согласно границе детектора: lookahead значения (?![A-Za-z0-9_.-]) отвергает utm_source=openair и chatgpt.com.example; хвост параметра останавливается на пробеле, &, #, ), `, <, > и кавычках — структура markdown-ссылки не разрушается",
        "маркеры вне текстового пути (sandbox_link, grok_card_tag) не снимаются: автофикс экшена отвечает UNFIXED и оставляет файл без изменений",
        "запись автофикса ограничена рабочим каталогом (GITHUB_WORKSPACE или текущий): путь вне него — отказ UNFIXED, не запись",
        "зазор схлопывается в точке съёма: снятие невидимого символа между пробелами не оставляет {2,} пробелов, замена неразрывного пробела рядом с обычным даёт один; авторская типографика вне точек съёма не трогается; кириллическая диакритика категории Mn сохраняется побайтно во всех режимах"
      ],
      "modes": [
        "--scan ФАЙЛ...",
        "--class a|all",
        "--json",
        "--remove ФАЙЛ...",
        "--include-ambiguous",
        "--dry-run",
        "--diff",
        "--in-place (.bak)",
        "--selftest (без файлов)",
        "- (stdin)",
        "--version",
        "--contract"
      ],
      "output_schema": {
        "type": "object",
        "required": [
          "tool",
          "schema",
          "files"
        ],
        "properties": {
          "tool": {
            "const": "humanizer-markers"
          },
          "schema": {
            "const": 1
          },
          "error": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "warnings_b": {
                  "type": "integer"
                },
                "scope_note": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                },
                "mode": {
                  "enum": [
                    "remove"
                  ]
                },
                "removed": {
                  "type": "array"
                },
                "reported": {
                  "type": "array"
                },
                "flag_sequences_kept": {
                  "type": "array"
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "removed_safe": {
                  "type": "integer"
                },
                "removed_ambiguous": {
                  "type": "integer"
                },
                "reported_total": {
                  "type": "integer"
                },
                "changed": {
                  "type": "boolean"
                },
                "markers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "line",
                      "marker",
                      "class",
                      "fragment",
                      "shadow"
                    ],
                    "properties": {
                      "line": {
                        "type": "integer"
                      },
                      "marker": {
                        "type": "string"
                      },
                      "class": {
                        "enum": [
                          "A",
                          "B"
                        ]
                      },
                      "fragment": {
                        "type": "string"
                      },
                      "shadow": {
                        "type": "boolean"
                      },
                      "start": {
                        "type": "integer",
                        "description": "начало совпадения в кодовых точках внутри строки (NFC); для shadow:true — внутри теневой строки без невидимых символов"
                      },
                      "end": {
                        "type": "integer",
                        "description": "конец совпадения (исключительно) в тех же координатах, что start"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "command": "humanizer-scan",
      "script": "scripts/scan_soft_signals.py",
      "task": "мягкие признаки машинного письма: счётчик по категориям, калибрует объём правки",
      "when_not": "вердикта об авторстве не даёт ни в каком сочетании признаков",
      "modes": [
        "ФАЙЛ...",
        "--genre",
        "--plain-text",
        "--json",
        "--fail-at N",
        "--fail-multicat N",
        "--max-cats N",
        "--selftest",
        "- (stdin)",
        "--version",
        "--contract"
      ],
      "output_schema": {
        "type": "object",
        "required": [
          "tool",
          "schema",
          "files"
        ],
        "properties": {
          "tool": {
            "const": "humanizer-scan"
          },
          "schema": {
            "const": 1
          },
          "error": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "genre": {
                  "type": "string"
                },
                "features_total": {
                  "type": "integer"
                },
                "categories_total": {
                  "type": "integer"
                },
                "recommendation": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "out-of-scope"
                  ]
                },
                "scope_note": {
                  "type": "string"
                },
                "findings": {
                  "type": "array"
                },
                "categories": {
                  "type": "object"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "command": "humanizer-facts",
      "script": "src/humanizer_ru/facts_diff.py",
      "task": "сверка фактов двух версий текста: числа с единицами, числительные, даты во всех русских форматах, URL, e-mail, заглавные последовательности как имена, кавычные цитаты, отрицания и модальности; выдаёт lost/added/changed с позициями",
      "transformation": "не меняет текст: только сравнивает; diff <до> <после> [--json]; коды выхода 0 — потерь и инверсий нет, 1 — есть lost или changed, 2 — вход не читается",
      "when_not": "не для текстов не на русском и не для исходного кода; не даёт вердиктов об авторстве, качестве и стиле; added не влияет на код выхода (их ловит check_examples.py)",
      "invariants": [
        "детерминированность",
        "без ML и внешних зависимостей",
        "позиции в символах от начала текста"
      ],
      "inputs": [
        "text_before",
        "text_after"
      ],
      "modes": [
        "diff <до> <после>",
        "--json",
        "--selftest",
        "--protect terms.txt"
      ],
      "output_schema": {
        "type": "object",
        "required": [
          "tool",
          "schema",
          "files",
          "counts",
          "diff"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "humanizer-facts"
            ]
          },
          "schema": {
            "type": "integer",
            "const": 1
          },
          "counts": {
            "type": "object",
            "required": [
              "lost",
              "added",
              "changed"
            ],
            "properties": {
              "lost": {
                "type": "integer"
              },
              "added": {
                "type": "integer"
              },
              "changed": {
                "type": "integer"
              }
            }
          },
          "diff": {
            "type": "object",
            "required": [
              "lost",
              "added",
              "changed"
            ],
            "properties": {
              "lost": {
                "type": "array"
              },
              "added": {
                "type": "array"
              },
              "changed": {
                "type": "array"
              }
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "command": "humanizer-report",
      "script": "src/humanizer_ru/edit_report.py",
      "task": "машиночитаемый отчёт правки: токены keep/add/delete, адаптированные компоненты SARI, классы правок, сверка фактов авторских категорий, MTLD до и после",
      "transformation": "не меняет текст: читает пару до/после и печатает конверт JSON или человекочитаемую сводку; вердиктов об авторстве не выносит",
      "when_not": "не для текстов не на русском и не для исходного кода; не даёт вердиктов об авторстве, качестве и стиле; added не влияет на код выхода (их ловит check_examples.py)",
      "output_schema": {
        "type": "object",
        "required": [
          "tool",
          "schema",
          "files"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "humanizer-report"
            ]
          },
          "schema": {
            "type": "integer",
            "const": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "before",
                "after",
                "tokens",
                "sari_adapted",
                "edit_types",
                "facts",
                "mtld"
              ],
              "properties": {
                "before": {
                  "type": "string"
                },
                "after": {
                  "type": "string"
                },
                "tokens": {
                  "type": "object",
                  "properties": {
                    "keep": {
                      "type": "integer"
                    },
                    "add": {
                      "type": "integer"
                    },
                    "delete": {
                      "type": "integer"
                    }
                  }
                },
                "sari_adapted": {
                  "type": "object",
                  "properties": {
                    "keep": {
                      "type": "number"
                    },
                    "add": {
                      "type": "number"
                    },
                    "delete": {
                      "type": "number"
                    }
                  }
                },
                "edit_types": {
                  "type": "object",
                  "properties": {
                    "invisible": {
                      "type": "integer"
                    },
                    "markup": {
                      "type": "integer"
                    },
                    "punctuation": {
                      "type": "integer"
                    },
                    "whitespace": {
                      "type": "integer"
                    },
                    "casing": {
                      "type": "integer"
                    },
                    "lexical": {
                      "type": "integer"
                    }
                  }
                },
                "facts": {
                  "type": "object",
                  "properties": {
                    "lost": {
                      "type": "integer"
                    },
                    "changed": {
                      "type": "integer"
                    },
                    "unchanged": {
                      "type": "boolean"
                    }
                  }
                },
                "mtld": {
                  "type": "object",
                  "properties": {
                    "before": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "after": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "modes": [
        "<до> <после>",
        "--json"
      ],
      "inputs": [
        "text_before",
        "text_after"
      ],
      "invariants": [
        "детерминированность",
        "без ML и внешних зависимостей",
        "не меняет текст: только отчёт"
      ]
    }
  ],
  "router": [
    {
      "need": "проверить текст на следы машинного происхождения",
      "use": "humanizer-detect + humanizer-markers"
    },
