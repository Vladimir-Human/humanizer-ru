{
  "version": 2,
  "about": "Признаки машинного стиля и технических сбоев в русском тексте для lint_style.py и страницы site/check. Это оценка стиля и чистоты текста, а не авторства: человек пишет так же, если торопится, а подмены букв и невидимые символы вызывают технические пометки при проверках. Каждое правило — регулярное выражение; \\b здесь значит границу слова с кириллицей, оба движка разворачивают его одинаково. Флаги по умолчанию: без учёта регистра. Номер sign — строка таблицы признаков в SKILL.md (0 — мусор чата и технические следы, шаг 1).",
  "phrases": [
    {"id": "chat_wrapper", "sign": 0, "name": "Обёртка ответа чат-бота", "re": "\\bконечно[!,]\\s+вот\\b|\\bвот\\s+(?:вариант|текст|пример|несколько\\s+вариантов|готовый)[а-яё]*[^.\\n]{0,40}:|\\b(?:вот|готовый)\\s+(?:(?:подробн|жив|полезн|готов|кратк|коротк|обновл[её]нн|исправленн|отредактированн|переписанн|улучшенн|аккуратн|сжат)[а-яё]*,?\\s+(?:и\\s+)?)+(?:вариант|текст|пример|черновик|пост|письмо|объявление|инструкция|описание)\\b[^.!?\\n]{0,90}[:.]|^[ \\t\\u00a0]*\\*?\\([~≈]?\\s*(?:около\\s+|примерно\\s+)?[0-9]+\\s*(?:знак|символ|слов)[^)\\n]{0,120}\\)\\*?[ \\t\\u00a0]*$|\\([~≈]\\s*[0-9]+\\s*(?:знак|символ|слов)[^)\\n]{0,120}\\)[ \\t\\u00a0]*:?[ \\t\\u00a0]*$|^[ \\t\\u00a0]*(?:небольшое\\s+уточнение|пара\\s+(?:уточнений|замечаний))\\b[^:\\n]{0,40}:|^[ \\t\\u00a0]*(?:\\[(?:рассуждения[^\\]\\n]*|ответ)\\]|источники?)[ \\t\\u00a0]*$|\\bнадеюсь,\\s+(?:это|эта\\s+информация|мой\\s+ответ)\\s+(?:поможет|будет\\s+полезн|была\\s+полезн)|\\bесли\\s+нужно,\\s+(?:могу|я\\s+могу|подготовлю|сделаю)\\b|\\bесли\\s+(?:хотите|хочешь),\\s+(?:могу|я\\s+могу)\\s+(?:добавить|сократить|переписать|сделать|адаптировать|расширить|убрать|подготовить)\\b|\\bесли\\s+(?:нужен|хочется|потребуется)\\s+(?:другой|чуть\\s+другой|более)\\b[^.!?\\n]{0,90}(?:скажите|напишите|перепишу|сокращу|добавлю|впишу)|\\bхотите,\\s+(?:я|чтобы\\s+я)\\b|\\bесли\\s+у\\s+(?:вас|тебя)\\s+(?:остались|возникнут|возникли|есть)\\s+(?:еще\\s+|ещё\\s+)?вопросы\\b", "flags": "im", "hint": "Убрать: это реплика чата, а не часть текста"},
    {"id": "assistant_context", "sign": 0, "name": "Следы контекста модели", "re": "\\b(?:в|из)\\s+предоставленн(?:ых|ой|ом|ого|ому)\\s+(?:результат|источник|данн|текст|фрагмент|материал)|\\bпо\\s+имеющ(?:ей|им)ся\\s+у\\s+меня\\s+(?:информации|данным|сведениям)\\b|\\bу\\s+меня\\s+нет\\s+доступа\\s+к\\b|\\bна\\s+момент\\s+моего\\s+(?:обучения|последнего\\s+обновления)\\b|\\bкак\\s+(?:языковая\\s+модель|ии-ассистент|искусственный\\s+интеллект),\\s+(?:я\\b|не\\s+могу\\b)", "hint": "Убрать"},
    {"id": "paste_garbage", "sign": 0, "name": "Мусор вставки", "re": "(?<![A-Za-z0-9_])utm_source=(?:chatgpt\\.com|openai|copilot\\.com|perplexity\\.ai|claude\\.ai|gemini\\.google\\.com|grok\\.com|(?:chat\\.)?deepseek\\.com)(?![0-9A-Za-zА-Яа-яЁё\\-]|[._%][0-9A-Za-zА-Яа-яЁё])|:{0,2}contentReference\\[oaicite:[0-9]+\\](?:\\{index=[0-9]+\\})?|\\[oaicite:[0-9]+\\](?:\\{index=[0-9]+\\})?|\\ue200[^\\ue201\\n]{0,400}\\ue201|\\uea01[^\\uea02\\n]{0,40}\\uea02|(?<!/)\\bcite(?:turn[0-9]+(?:search|fetch|file|image|news|video|ref|view|product|finance|map|sports|weather|local|code|calc|browser)[0-9]+)+\\b|【[0-9]+(?:[:\\-–,][ \\t]*[0-9]+)*(?:†[^】\\n]{0,80})?】|\\[cite_start\\]|\\[cite(?:_end)?(?::[ \\t]*[0-9]+(?:[ \\t]*[\\-–,][ \\t]*[0-9]+)*[ \\t]*)?\\]|\\[(?:citation|attached_file|web):[ \\t]*[0-9]+(?:[ \\t]*[\\-–,][ \\t]*[0-9]+)*[ \\t]*\\]|\\[span_[0-9]+\\][\\[(](?:start_span|end_span)[\\])]|\\[\\^[0-9]+\\^\\]|</?antml:cite(?:[ \\t]+[^>\\n]{0,200})?>|<cite[ \\t]+index=(?:\"[^\"\\n]{0,120}\"|'[^'\\n]{0,120}')[ \\t]*>", "hint": "Убрать (clean_paste.py)"},
    {"id": "empty_opener", "sign": 1, "name": "Пустая подводка", "re": "\\b(?:важно|стоит|следует|необходимо)\\s+(?:отметить|подчеркнуть|упомянуть|заметить)\\b|\\bважно\\s+понимать\\b|\\bдава(?:й|йте)\\s+(?:разбер[её]м(?:ся)?|рассмотрим|поговорим|посмотрим|узнаем)\\b|\\bв\\s+современном\\s+(?:мире|обществе)\\b|\\bв\\s+наше\\s+время\\b|\\bне\\s+секрет,?\\s+что\\b|\\bни\\s+для\\s+кого\\s+не\\s+секрет\\b", "hint": "Удалить, начать с сути"},
    {"id": "false_contrast", "sign": 2, "name": "Ложный контраст", "re": "\\bне\\s+просто\\b[^.!?\\n]{0,80}?,\\s*(?:а|это)\\b|\\bэто\\s+не\\s+про\\b|\\bречь\\s+не\\s+(?:о|об|про)\\b|\\bдело\\s+не\\s+(?:только\\s+)?в\\b|\\bэто\\s+(?:был[аои]?\\s+)?не\\s+(?:просто\\s+)?[а-яё]{4,25},\\s*а\\s+[а-яё]{4,}", "hint": "Сказать Y прямо, если X никто не утверждал"},
    {"id": "ne_tolko_no_i", "sign": 2, "name": "«Не только…, но и…»", "re": "\\bне\\s+только\\b[^.!?\\n]{0,100}?,\\s*но\\s+и\\b", "hint": "Оставить, если X правда и важно; иначе сказать прямо", "soft": true},
    {"id": "inflated", "sign": 3, "name": "Раздутая значимость", "re": "\\bигра(?:ет|ют|ть|л|ла|ли|я|ющ[а-яё]*)\\s+(?:ключев|важн|решающ|значим|центральн|огромн)[а-яё]*\\s+рол|\\bнеотъемлем[а-яё]*\\s+част|\\bоткрыва(?:ет|ют|я)\\s+(?:новые|широкие|безграничные)\\s+(?:возможност|горизонт|перспектив)|\\bвыв(?:одит|одят|ести|ед[её]т|ел|ела)\\s+на\\s+(?:новый|качественно\\s+новый|иной)\\s+уровень|\\bкомплексн[а-яё]*\\s+подход|\\bв\\s+центре\\s+внимания\\b|\\bпредмет(?:ом|а)\\s+(?:пристального\\s+|особого\\s+|широкого\\s+)?(?:внимания|обсуждения|споров|дискуссий)\\b", "hint": "Назвать конкретику из текста или убрать"},
    {"id": "symbolism", "sign": 3, "name": "Символизм и пафос места", "re": "\\bсимволизир|\\b(?:служ(?:ит|ат|ил[аои]?)|ста(?:л[аои]?|нет|нут))\\s+(?:[а-яё]{3,16}\\s+)?напоминанием\\b|\\bнеизгладим|\\bповоротн(?:ый|ым|ого|ом|ые|ых|ыми|ая|ой|ую)\\s+(?:момент|точк|этап|вех)|\\bв\\s+самом\\s+сердце\\b|\\b(?:мож(?:ет|ете)|мог(?:ут|ла|ли)?|смож(?:ет|ут))\\s+похвастаться\\b|\\bбогат(?:ое|ого|ому|ым|ом|ая|ой|ую)\\s+(?:культурн[а-яё]+\\s+)?наследи|\\bзахватывающ", "hint": "Конкретный факт вместо оценки"},
    {"id": "unique", "sign": 3, "name": "«Уникальный»", "re": "\\bуникальн(?:ый|ая|ое|ые|ого|ую|ой|ым|ых|ыми)\\b", "hint": "Чем именно? Назвать или убрать", "soft": true},
    {"id": "cleft_imenno", "sign": 3, "name": "Усилительное «именно»", "re": "(?:^|[.!?…—–:][ \\t\\u00a0]+|,\\s*(?:а|но|ведь|поскольку)\\s+)именно\\s+(?!в\\s+[0-9]|сегодня\\b|вчера\\b|завтра\\b|здесь\\b|тут\\b)[а-яё]{2,}|(?<!что\\s)(?<!как\\s)(?<!где\\s)(?<!кто\\s)(?<!почему\\s)(?<!когда\\s)(?<!зачем\\s)(?<!куда\\s)\\bименно\\s+(?:поэтому|это|эта|этот|эти|он|она|они|так|в\\s+этом|такой|такая|такое|такие)\\b", "flags": "im", "hint": "Сказать прямо без нажима, если нет спора о выборе", "soft": true},
    {"id": "kantselyarit", "sign": 4, "name": "Канцелярит", "re": "\\bданн(?:ый|ая|ое|ого|ой|ую|ом|ому)\\b(?!\\s+(?:мне|тебе|ему|ей|нам|вам|им|богом|свыше|природой|слово|слова|обещан[а-яё]*|клятв[а-яё]*)\\b)|\\bпредставля(?:ет|ют)\\s+собой\\b|\\bосуществ(?:ля[а-яё]*|ить|ил|ила|ило|или|ит|ят)\\b|\\bв\\s+целях\\b|\\bна\\s+сегодняшний\\s+день\\b|\\bобеспечени[ея]\\s+повышения\\b", "hint": "Глагол и подлежащее: «этот», «делать», «сейчас», «чтобы»", "soft": true},
    {"id": "yavlyaetsya", "sign": 4, "name": "«Является»", "re": "\\bявля(?:ется|ются)\\b", "hint": "Часто хватает тире или «это»", "soft": true},
    {"id": "calque", "sign": 5, "name": "Калька с английского", "re": "\\bбесшовн|\\bадресова[а-яё]*\\s+(?:проблем|вопрос|задач)|\\b(?:нов|главн|основн|серь[её]зн|современн|ключев)[а-яё]*\\s+вызов|\\bв\\s+конечном\\s+итоге\\b|\\bна\\s+ежедневной\\s+основе\\b|\\bпогруз(?:иться|имся|итесь|ись|ившись)\\s+в\\s+мир\\b|\\bэкосистем|\\bинсайт", "hint": "Обычные русские слова"},
    {"id": "odnako_comma", "sign": 5, "name": "«Однако,» в начале фразы", "re": "(?:^|[.!?…][ \\t\\u00a0]+)однако,", "flags": "im", "hint": "Запятая после «Однако» в начале фразы не нужна", "soft": true},
    {"id": "significance_tail", "sign": 6, "name": "Хвост значимости", "re": ",\\s+(?:подч[её]ркивая|демонстрируя|отражая|свидетельствуя|способствуя|содействуя)\\b|,\\s+что\\s+свидетельствует\\s+о\\b|\\bделая\\s+(?:его|е[её]|их)\\s+(?:идеальн|отличн|лучш)[а-яё]*\\s+выбор|\\b(?:решени|инструмент|платформ|сервис)[а-яё]*,\\s+позволяющ", "hint": "Убрать хвост; факт из него сделать отдельной фразой"},
    {"id": "anonymous_authority", "sign": 7, "name": "Безымянный авторитет", "re": "\\bэксперты\\s+(?:отмечают|считают|рекомендуют|утверждают|сходятся|предупреждают|советуют)\\b|\\bпо\\s+(?:словам|мнению|оценкам)\\s+экспертов\\b|\\bисследования\\s+(?:показывают|подтверждают|доказывают)\\b|\\bмногие\\s+(?:считают|эксперты|специалисты)\\b|\\bуч[её]ные\\s+(?:доказали|выяснили)\\b", "hint": "Назвать источник, если он есть; мнение оставить мнением", "soft": true},
    {"id": "triad", "sign": 8, "name": "Тройка однородных оценок", "re": "\\b(?!(?:[а-яё]+(?:ство|[ое]го)|молоко|масло|мясо|яблоко|зеркало|письмо|слово|дело|место|окно|село|кино|вино|пиво|мыло|золото|серебро|дерево|небо|тело|лицо|яйцо|кольцо|крыло|стекло|число|кресло|весло|судно|блюдо|фото|авто|метро|бюро|депо|пальто|ведро|ядро|ребро|тесто|лето|утро|право|начало|правило|топливо|колесо|озеро|болото|полотно|бревно|зерно|пятно|звено|сало|радио|видео|аудио|табло|панно|домино|казино|лото|манго|какао|эспрессо|капучино|американо|ризотто|песто|авокадо|торнадо|эмбарго|лого|сальдо|брутто|нетто)\\b)[а-яё]{3,}(?:о|ый|ий|ая|яя|ое|ее|ые|ие),\\s+(?!(?:[а-яё]+(?:ство|[ое]го)|молоко|масло|мясо|яблоко|зеркало|письмо|слово|дело|место|окно|село|кино|вино|пиво|мыло|золото|серебро|дерево|небо|тело|лицо|яйцо|кольцо|крыло|стекло|число|кресло|весло|судно|блюдо|фото|авто|метро|бюро|депо|пальто|ведро|ядро|ребро|тесто|лето|утро|право|начало|правило|топливо|колесо|озеро|болото|полотно|бревно|зерно|пятно|звено|сало|радио|видео|аудио|табло|панно|домино|казино|лото|манго|какао|эспрессо|капучино|американо|ризотто|песто|авокадо|торнадо|эмбарго|лого|сальдо|брутто|нетто)\\b)[а-яё]{3,}(?:о|ый|ий|ая|яя|ое|ее|ые|ие)\\s+и\\s+(?!(?:[а-яё]+(?:ство|[ое]го)|молоко|масло|мясо|яблоко|зеркало|письмо|слово|дело|место|окно|село|кино|вино|пиво|мыло|золото|серебро|дерево|небо|тело|лицо|яйцо|кольцо|крыло|стекло|число|кресло|весло|судно|блюдо|фото|авто|метро|бюро|депо|пальто|ведро|ядро|ребро|тесто|лето|утро|право|начало|правило|топливо|колесо|озеро|болото|полотно|бревно|зерно|пятно|звено|сало|радио|видео|аудио|табло|панно|домино|казино|лото|манго|какао|эспрессо|капучино|американо|ризотто|песто|авокадо|торнадо|эмбарго|лого|сальдо|брутто|нетто)\\b)[а-яё]{3,}(?:о|ый|ий|ая|яя|ое|ее|ые|ие)\\b", "hint": "Оставить то, за чем есть факт", "soft": true},
    {"id": "moral_ending", "sign": 9, "name": "Концовка-мораль", "re": "^[ \\t\\u00a0]*(?:в\\s+заключение|подводя\\s+итог|подытоживая|вкратце|резюмируя|таким\\s+образом)\\b|\\bи\\s+это\\s+главное\\b|\\bбудущее\\s+уже\\s+(?:здесь|наступило)\\b|\\bнесмотря\\s+на\\b[^.!?\\n]{0,120}?(?:сталкива|вызов|трудност)", "flags": "im", "hint": "Закончить последним фактом, действием или контактом"},
    {"id": "teaser", "sign": 10, "name": "Интрига с готовым ответом", "re": "\\bпочему\\s+это\\s+важно\\?|\\bчто\\s+это\\s+значит\\?|\\bв\\s+ч[её]м\\s+(?:секрет|подвох|разница|суть)\\?|(?:^|[.!?…][ \\t\\u00a0]+|\\*\\*|#{1,6}[ \\t]+)(?:результат|итог|ответ|разница|секрет|суть|вывод|причина)\\?(?:\\*\\*|\\s|$)|\\bсекрет\\s+прост\\b|\\bмало\\s+кто\\s+знает\\b|\\?\\s+(?:потому\\s+что|вс[её]\\s+просто|ответ\\s+прост|разбираемся\\b)", "flags": "im", "hint": "Утверждение"},
    {"id": "metatext", "sign": 11, "name": "Метатекст", "re": "\\bв\\s+(?:этой|данной|нашей)\\s+(?:статье|публикации|заметке|подборке)\\s+(?:мы\\s+)?(?:рассмотрим|расскажем|разбер[её]м|поговорим|узнаем)\\b|\\bниже\\s+(?:представлен|приведен|приведён|перечислен)[а-яё]*|\\bкак\\s+уже\\s+(?:было\\s+)?(?:сказано|упомянуто|отмечалось)\\b|\\b(?:иными|другими)\\s+словами\\b", "hint": "Убрать"},
    {"id": "media_metatext", "sign": 11, "name": "Безличная отсылка («как отмечается»)", "re": "\\bкак\\s+(?:отмечается|сообщается|подч[её]ркивается|уточняется|указывается)\\b|\\bстоит\\s+напомнить,?\\s+что\\b|(?:^|[.!?…][ \\t\\u00a0]+)напомним,\\s+что\\b|\\bна\\s+момент\\s+публикации\\b", "flags": "im", "hint": "Назвать источник прямо или убрать безличную подводку", "soft": true},
    {"id": "empty_general", "sign": 12, "name": "Пустое обобщение", "re": "\\bразличн(?:ые|ых)\\s+(?:аспект|сфер|област|направлени)|\\bряд\\s+преимуществ\\b|\\bширок(?:ий|ого|ому|им)\\s+спектр|\\bот\\s+(?:стартап[а-яё]*|малого\\s+бизнеса)\\s+до\\s+(?:корпорац|крупн)", "hint": "Конкретно или убрать"},
    {"id": "news_stamp", "sign": 12, "name": "Штампы сводки («на фоне», «остаётся»)", "re": "\\bоста(?:[её]тся|ются|вался|валась|валось|вались|нется|нутся)\\s+(?:неизвестн|неясн|открыт|под\\s+вопросом|актуальн|высок|сложн|напряж[её]нн|одной\\s+из|одним\\s+из|в\\s+центре|предметом|ключев|неизменн|нереш[её]нн|спорн|неопредел[её]нн|чувствительн|приоритет|единственн|крупнейш|важнейш|главн|под\\s+контролем|без\\s+внимания|в\\s+тени|в\\s+силе|в\\s+числе|в\\s+статусе)|\\bна\\s+фоне\\s+[а-яё]{4,}|\\bнеоднократно\\b", "hint": "Назвать конкретную причину или состояние без газетного штампа", "soft": true},
