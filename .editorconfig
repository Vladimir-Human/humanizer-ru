# https://editorconfig.org
# Единый стиль файлов: UTF-8, LF, без трейлинг-пробелов.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# В Markdown два пробела в конце строки — значимый перенос.
trim_trailing_whitespace = false
