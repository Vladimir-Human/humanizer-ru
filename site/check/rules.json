{
  "version": 1,
  "about": "Признаки машинного стиля в русском тексте для lint_style.py и страницы site/check. Это стиль, а не авторство: человек пишет так же, если торопится. Каждое правило — регулярное выражение; \\b здесь значит границу слова с кириллицей, оба движка разворачивают его одинаково. Флаги по умолчанию: без учёта регистра. Номер sign — строка таблицы признаков в SKILL.md (0 — мусор чата, шаг 1).",
  "phrases": [
    {"id": "chat_wrapper", "sign": 0, "name": "Обёртка ответа чат-бота", "re": "\\bконечно[!,]\\s+вот\\b|\\bвот\\s+(?:вариант|текст|пример|несколько\\s+вариантов|готовый)\\S*[^.\\n]{0,40}:|\\bнадеюсь,\\s+(?:это|эта\\s+информация|мой\\s+ответ)\\s+(?:поможет|будет\\s+полезн|была\\s+полезн)|\\bесли\\s+нужно,\\s+(?:могу|я\\s+могу|подготовлю|сделаю)\\b|\\bхотите,\\s+(?:я|чтобы\\s+я)\\b|\\bесли\\s+у\\s+вас\\s+(?:остались|возникнут|возникли|есть)\\s+(?:еще\\s+|ещё\\s+)?вопросы\\b", "hint": "Убрать: это реплика чата, а не часть текста"},
    {"id": "assistant_context", "sign": 0, "name": "Следы контекста модели", "re": "\\bв\\s+предоставленн(?:ых|ой|ом)\\s+(?:результат|источник|данн|текст)|\\bпо\\s+имеющейся\\s+у\\s+меня\\s+информации\\b|\\bна\\s+момент\\s+моего\\s+(?:обучения|последнего\\s+обновления)\\b|\\bкак\\s+(?:языковая\\s+модель|ии-ассистент|искусственный\\s+интеллект),\\s+я\\b", "hint": "Убрать"},
    {"id": "paste_garbage", "sign": 0, "name": "Мусор вставки", "re": "utm_source=(?:chatgpt\\.com|openai)|:?contentReference\\[oaicite:\\d+\\](?:\\{index=\\d+\\})?|\\[oaicite:\\d+\\]", "hint": "Убрать (clean_paste.py)"},
    {"id": "empty_opener", "sign": 1, "name": "Пустая подводка", "re": "\\b(?:важно|стоит|следует|необходимо)\\s+(?:отметить|подчеркнуть|упомянуть|заметить)\\b|\\bважно\\s+понимать\\b|\\bдавайте\\s+(?:разбер[её]мся|рассмотрим|поговорим|посмотрим|узнаем)\\b|\\bв\\s+современном\\s+(?:мире|обществе)\\b|\\bв\\s+наше\\s+время\\b|\\bне\\s+секрет,?\\s+что\\b|\\bни\\s+для\\s+кого\\s+не\\s+секрет\\b", "hint": "Удалить, начать с сути"},
    {"id": "false_contrast", "sign": 2, "name": "Ложный контраст", "re": "\\bне\\s+просто\\b[^.!?\\n]{0,80}?,\\s*(?:а|это)\\b|\\bэто\\s+не\\s+про\\b|\\bречь\\s+не\\s+(?:о|об|про)\\b|\\bдело\\s+не\\s+(?:только\\s+)?в\\b", "hint": "Сказать Y прямо, если X никто не утверждал"},
    {"id": "ne_tolko_no_i", "sign": 2, "name": "«Не только…, но и…»", "re": "\\bне\\s+только\\b[^.!?\\n]{0,100}?,\\s*но\\s+и\\b", "hint": "Оставить, если X правда и важно; иначе сказать прямо", "soft": true},
    {"id": "inflated", "sign": 3, "name": "Раздутая значимость", "re": "\\bигра(?:ет|ют|ть|л|ла|ли|я|ющ\\S*)\\s+(?:ключев|важн|решающ|значим|центральн|огромн)\\S*\\s+рол|\\bнеотъемлем\\S*\\s+част|\\bоткрыва(?:ет|ют|я)\\s+(?:новые|широкие|безграничные)\\s+(?:возможност|горизонт|перспектив)|\\bвыв(?:одит|одят|ести|ед[её]т|ел|ела)\\s+на\\s+(?:новый|качественно\\s+новый|иной)\\s+уровень|\\bкомплексн\\S*\\s+подход", "hint": "Назвать конкретику из текста или убрать"},
    {"id": "symbolism", "sign": 3, "name": "Символизм и пафос места", "re": "\\bсимволизир|\\bслужит\\s+напоминанием\\b|\\bнеизгладим|\\bповоротн(?:ый|ым|ого)\\s+момент|\\bв\\s+самом\\s+сердце\\b|\\bможет\\s+похвастаться\\b|\\bбогат(?:ое|ым|ой)\\s+(?:культурн\\S+\\s+)?наследи|\\bзахватывающ", "hint": "Конкретный факт вместо оценки"},
    {"id": "unique", "sign": 3, "name": "«Уникальный»", "re": "\\bуникальн(?:ый|ая|ое|ые|ого|ую|ой|ым|ых|ыми)\\b", "hint": "Чем именно? Назвать или убрать", "soft": true},
    {"id": "kantselyarit", "sign": 4, "name": "Канцелярит", "re": "\\bданн(?:ый|ая|ое|ого|ой|ую|ом|ому)\\b|\\bпредставля(?:ет|ют)\\s+собой\\b|\\bосуществ(?:ля\\S*|ить|ил|ила|ило|или|ит|ят)\\b|\\bв\\s+целях\\b|\\bна\\s+сегодняшний\\s+день\\b|\\bобеспечени[ея]\\s+повышения\\b", "hint": "Глагол и подлежащее: «этот», «делать», «сейчас», «чтобы»", "soft": true},
    {"id": "yavlyaetsya", "sign": 4, "name": "«Является»", "re": "\\bявля(?:ется|ются)\\b", "hint": "Часто хватает тире или «это»", "soft": true},
    {"id": "calque", "sign": 5, "name": "Калька с английского", "re": "\\bбесшовн|\\bадресова\\S*\\s+(?:проблем|вопрос|задач)|\\b(?:нов|главн|основн|серь[её]зн|современн|ключев)\\S*\\s+вызов|\\bв\\s+конечном\\s+итоге\\b|\\bна\\s+ежедневной\\s+основе\\b|\\bпогруз(?:иться|имся|итесь|ись|ившись)\\s+в\\s+мир\\b|\\bэкосистем|\\bинсайт", "hint": "Обычные русские слова"},
    {"id": "odnako_comma", "sign": 5, "name": "«Однако,» в начале фразы", "re": "(?:^|[.!?…]\\s+)однако,", "flags": "im", "hint": "Запятая после «Однако» в начале фразы не нужна", "soft": true},
    {"id": "significance_tail", "sign": 6, "name": "Хвост значимости", "re": ",\\s+(?:подч[её]ркивая|демонстрируя|отражая|свидетельствуя|способствуя|содействуя)\\b|,\\s+что\\s+свидетельствует\\s+о\\b|\\bделая\\s+(?:его|е[её]|их)\\s+(?:идеальн|отличн|лучш)\\S*\\s+выбор|\\b(?:решени|инструмент|платформ|сервис)\\S*,\\s+позволяющ", "hint": "Убрать хвост; факт из него сделать отдельной фразой"},
    {"id": "anonymous_authority", "sign": 7, "name": "Безымянный авторитет", "re": "\\bэксперты\\s+(?:отмечают|считают|рекомендуют|утверждают|сходятся|предупреждают|советуют)\\b|\\bпо\\s+(?:словам|мнению|оценкам)\\s+экспертов\\b|\\bисследования\\s+(?:показывают|подтверждают|доказывают)\\b|\\bмногие\\s+(?:считают|эксперты|специалисты)\\b|\\bуч[её]ные\\s+(?:доказали|выяснили)\\b", "hint": "Назвать источник, если он есть; мнение оставить мнением", "soft": true},
    {"id": "triad", "sign": 8, "name": "Тройка однородных оценок", "re": "\\b[а-яё]{3,}(?:о|ый|ий|ая|яя|ое|ее|ые|ие),\\s+[а-яё]{3,}(?:о|ый|ий|ая|яя|ое|ее|ые|ие)\\s+и\\s+[а-яё]{3,}(?:о|ый|ий|ая|яя|ое|ее|ые|ие)\\b", "hint": "Оставить то, за чем есть факт", "soft": true},
    {"id": "moral_ending", "sign": 9, "name": "Концовка-мораль", "re": "^\\s*(?:в\\s+заключение|подводя\\s+итог|подытоживая|вкратце|резюмируя|таким\\s+образом)\\b|\\bи\\s+это\\s+главное\\b|\\bбудущее\\s+уже\\s+(?:здесь|наступило)\\b|\\bнесмотря\\s+на\\b[^.!?\\n]{0,120}?(?:сталкива|вызов|трудност)", "flags": "im", "hint": "Закончить последним фактом, действием или контактом"},
    {"id": "teaser", "sign": 10, "name": "Интрига с готовым ответом", "re": "\\bпочему\\s+это\\s+важно\\?|\\bчто\\s+это\\s+значит\\?|(?:^|[.!?…]\\s+)(?:результат|итог|ответ|разница|секрет|суть|вывод)\\?\\s|\\bсекрет\\s+прост\\b|\\bмало\\s+кто\\s+знает\\b|\\?\\s+(?:потому\\s+что|вс[её]\\s+просто|ответ\\s+прост)", "flags": "im", "hint": "Утверждение"},
    {"id": "metatext", "sign": 11, "name": "Метатекст", "re": "\\bв\\s+(?:этой|данной|нашей)\\s+(?:статье|публикации|заметке|подборке)\\s+(?:мы\\s+)?(?:рассмотрим|расскажем|разбер[её]м|поговорим|узнаем)\\b|\\bниже\\s+(?:представлен|приведен|приведён|перечислен)\\S*|\\bкак\\s+уже\\s+(?:было\\s+)?(?:сказано|упомянуто|отмечалось)\\b|\\b(?:иными|другими)\\s+словами\\b", "hint": "Убрать"},
    {"id": "empty_general", "sign": 12, "name": "Пустое обобщение", "re": "\\bразличн(?:ые|ых)\\s+(?:аспект|сфер|област|направлени)|\\bряд\\s+преимуществ\\b|\\bширок(?:ий|ого|ому|им)\\s+спектр|\\bот\\s+(?:стартап\\S*|малого\\s+бизнеса)\\s+до\\s+(?:корпорац|крупн)", "hint": "Конкретно или убрать"},
    {"id": "connector_opener", "sign": 13, "name": "Связка в начале абзаца", "re": "^\\s*(?:кроме\\s+того|более\\s+того|помимо\\s+этого|также\\s+стоит\\s+отметить|вместе\\s+с\\s+тем)\\b", "flags": "im", "hint": "Убрать большую часть: связь видна из смысла", "soft": true},
    {"id": "bold_label", "sign": 15, "name": "Жирная метка", "re": "\\*\\*[^*\\n]{1,40}:\\*\\*|\\*\\*[^*\\n]{1,40}\\*\\*:", "hint": "Обычный текст"},
    {"id": "hedge_cascade", "sign": 17, "name": "Каскад оговорок", "re": "\\bможет\\s+потенциально\\b|\\bпотенциально\\s+может\\b|\\bкак\\s+правило,\\s+в\\s+большинстве\\s+случаев\\b|\\bв\\s+некоторых\\s+случаях\\s+может\\b|\\bвозможно,\\s+(?:может|могут|способн)", "hint": "Одну оговорку оставить, повтор убрать"},
    {"id": "business_pathos", "sign": 18, "name": "Пафос в деловом тексте", "re": "\\bрады\\s+(?:сообщить|представить|объявить|приветствовать)\\b|\\bс\\s+гордостью\\s+(?:представляем|сообщаем|объявляем)\\b|\\bвпечатляющ|\\bвдохновля(?:ет|ют|ющ)", "hint": "Сказать, что произошло"},
    {"id": "template_politeness", "sign": 19, "name": "Шаблонная вежливость", "re": "\\bнадеемся\\s+на\\s+(?:ваше\\s+)?понимание\\b|\\bбудем\\s+рады\\s+видеть\\s+вас\\b|\\bспасибо,\\s+что\\s+(?:вы\\s+)?с\\s+нами\\b|\\bблагодарим\\s+за\\s+(?:понимание|внимание)\\b|\\bне\\s+стесняйтесь\\s+(?:обращаться|задавать|писать)\\b", "hint": "Оставить одну, если она уместна в жанре"}
  ],
  "metrics": {
    "dash_per_1000": {"sign": 16, "name": "Тире на 1000 знаков", "max": 6.0, "hint": "Заменить часть тире запятой, двоеточием или точкой"},
    "sentence_cv": {"sign": 14, "name": "Разброс длины фраз (ритм метронома)", "min": 0.3, "min_sentences": 8, "score": false, "hint": "Чередовать короткие и длинные фразы"},
    "same_opener_share": {"sign": 14, "name": "Доля фраз с одним и тем же первым словом", "max": 0.3, "min_sentences": 6, "score": false, "hint": "Разные начала фраз"},
    "bold_per_line": {"sign": 15, "name": "Выделений жирным на строку", "max": 0.5, "min_lines": 3, "hint": "Жирный — только для того, что нельзя пропустить"},
    "heading_share": {"sign": 15, "name": "Доля строк-заголовков", "max": 0.34, "min_lines": 4, "hint": "Заголовок над каждым абзацем не нужен"},
    "emoji_per_1000": {"sign": 15, "name": "Эмодзи на 1000 знаков", "max": 3.0, "ranges": [[9728, 10175], [11088, 11088], [11093, 11093], [126976, 129791]], "hint": "Эмодзи-маркеры убрать, если жанр не требует"},
    "invisible": {"sign": 0, "name": "Невидимые символы", "max": 0, "codepoints": [173, 6158, 8203, 8206, 8207, 8234, 8235, 8236, 8237, 8238, 8288, 8294, 8295, 8296, 8297, 65279], "hint": "Убрать (clean_paste.py)"}
  },
  "levels": {"some": 2.0, "many": 5.0, "min_words": 300, "about": "Балл = срабатывания фраз (мягкие правила по 0,5) на 1000 слов, но не меньше чем на 300 слов, плюс 1 за каждую метрику за пределом; метрики с score: false показаны для сведения и в балл не входят (у людей в новостях длина фраз ровнее, чем у моделей). Пороги подобраны по 150 статьям Викиновостей до 2022 года: см. eval/results/style-lint/calibration.md."}
}
